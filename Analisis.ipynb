     "text": [
      "    Constante     Rama P     Rama R  Diferencia (%)\n",
      "  nu_k (cm-1) 2349.55884 2348.80491         0.03209\n",
      "B_vk=1 (cm-1)    0.77198    0.77475         0.35775\n",
      "B_vk=0 (cm-1)    0.78408    0.78685         0.35281\n"
     ]
    }
   ],
   "source": [
    "# Rama P (x = J):    nu = nu0 - (B1+B0) J + (B1-B0) J^2\n",
    "# Rama R (x = J+1):  nu = nu0 + (B1+B0)(J+1) + (B1-B0)(J+1)^2\n",
    "xP, yP = JP, P_picos[:NP]\n",
    "xR, yR = JR+1, R_picos[:NR]\n",
    "\n",
    "aP, bP, cP = np.polyfit(xP, yP, 2)\n",
    "aR, bR, cR = np.polyfit(xR, yR, 2)\n",
    "\n",
    "def constantes(a, b, c, rama):\n",
    "    if rama == 'P':\n",
    "        B1, B0 = (a - b)/2, (-a - b)/2\n",
    "    else:\n",
    "        B1, B0 = (a + b)/2, (b - a)/2\n",
    "    return c, B1, B0\n",
    "\n",
    "nu0_P, B1_P, B0_P = constantes(aP, bP, cP, 'P')\n",
    "nu0_R, B1_R, B0_R = constantes(aR, bR, cR, 'R')\n",
    "\n",
    "xs = np.linspace(0, 21, 200)\n",
    "\n",
    "# Gráfica 2a. Rama P\n",
    "plt.plot(xP, yP, 'o', color='tab:blue', label='Picos')\n",
    "plt.plot(xs, np.polyval([aP, bP, cP], xs), 'k--',\n",
    "         label=f'Ajuste: {aP:.4f}J² {bP:+.4f}J {cP:+.2f}')\n",
    "plt.xlabel('J', fontsize = 14)\n",
    "plt.ylabel(r'$\\tilde{\\nu}$ (cm$^{-1}$)',fontsize = 14)\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.legend(fontsize = 12)\n",
    "plt.show()\n",
    "\n",
    "# Gráfica 2b. Rama R\n",
    "plt.plot(xR, yR, 'o', color='tab:red', label='Picos')\n",
    "plt.plot(xs, np.polyval([aR, bR, cR], xs), 'k--',\n",
    "         label=f'Ajuste: {aR:.4f}(J+1)² {bR:+.4f}(J+1) {cR:+.2f}')\n",
    "plt.xlabel('J + 1',fontsize = 14)\n",
    "plt.ylabel(r'$\\tilde{\\nu}$ (cm$^{-1}$)',fontsize = 14)\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.legend(fontsize = 12)\n",
    "plt.show()\n",
    "\n",
    "# Comparación\n",
    "def dif(p, r): \n",
    "    return 100*abs(p - r)/((p + r)/2)\n",
    "\n",
    "res = pd.DataFrame({\n",
    "    'Constante': ['nu_k (cm-1)', 'B_vk=1 (cm-1)', 'B_vk=0 (cm-1)'],\n",
    "    'Rama P': [nu0_P, B1_P, B0_P],\n",
    "    'Rama R': [nu0_R, B1_R, B0_R],\n",
    "})\n",
    "res['Diferencia (%)'] = [dif(p, r) for p, r in zip(res['Rama P'], res['Rama R'])]\n",
    "print(res.to_string(index=False, float_format=lambda v: f'{v:.5f}'))"
