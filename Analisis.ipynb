    "plt.figure(figsize=(17, 6.5))\n",
    "plt.plot(NumOnd, Abs, color='green', lw=1.2)\n",
    "plt.axvline(x0, color='black', lw=1.2)\n",
    "\n",
    "# alturas de los picos\n",
    "hP = np.interp(P_picos, NumOnd, Abs)\n",
