   "outputs": [],
   "source": [
    "idx, _ = sp.signal.find_peaks(Abs, prominence=1)   #prominence ajusta cuántos picos se obtienen\n",
    "picos = NumOnd[idx]\n",
    "\n",
    "#El origen de banda está en el hueco entre ramas\n",
    "#Se encuentra como la mayor separación entre picos consecutivos:\n",
    "dif = np.diff(picos)\n",
    "centro = (picos[:-1] + picos[1:]) / 2          # punto medio entre picos consecutivos\n",
    "cand = np.where((centro > 2340) & (centro < 2360))[0]   # solo la zona del origen de banda\n",
    "gap = cand[np.argmax(dif[cand])]\n",
    "\n",
    "P_picos = picos[:gap+1][::-1]   #descendente: J=1 es el pico más cercano al hueco\n",
    "R_picos = picos[gap+1:]         #ascendente: J=0 es el pico más cercano al hueco\n",
    "\n",
    "J_P = np.arange(1, len(P_picos)+1)\n",
    "J_R = np.arange(0, len(R_picos))"
   ]
  },
