   "source": [
    "Tabla = pd.read_csv('Tabla posiciones y FWHM Caso1.csv', sep = ';', decimal= ',').sort_values(by = [\"Centro(MHz)\"], ascending=False)\n",
    "\n",
    "display(Tabla)\n",
    "Picos = np.arange(0,Tabla.shape[0],1)**2\n",
    "\n",
    "result = sp.stats.linregress(Picos, Tabla[\"Centro(MHz)\"])\n",
    "m, b, R2 = result.slope, result.intercept, np.abs(result.rvalue)\n",
    "print(m,b,R2)\n",
    "\n",
    "x = np.linspace(0,50,100)\n",
    "plt.plot(Picos, Tabla[\"Centro(MHz)\"], 'o', label = f'{m:.4f}x+ {b:.0f}, R^2 = {R2:.2f}')\n",
    "plt.plot(x, m*x + b, '--' ,alpha = 0.5, color = 'green', label = \"Ajuste lineal\")\n",
    "plt.grid(True)\n",
    "plt.title(\"Frecuencia de Picos vs K^2\")\n",
    "plt.ylabel(\"Frecuencia del pico (MHz)\")\n",
    "plt.xlabel(\"K^2\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "\n"
   ]
  },
