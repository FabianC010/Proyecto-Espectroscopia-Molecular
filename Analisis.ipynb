    "    \n",
    "plt.text(2311, 14, 'Rama P', fontsize=15, color='blue', fontweight='bold')\n",
    "plt.text(2381, 14, 'Rama R', fontsize=15, color='red', fontweight='bold')\n",
    "plt.xlabel('Número de onda (cm-1)', fontsize=14)\n",
